# ==============================================================================
# Edsy Notes - Supabase Environment Configuration (Root Template)
# ==============================================================================
# To configure Supabase for the web application:
# 1. Copy this file to `web/.env`
# 2. Open `web/.env` and replace the placeholder values with your Supabase credentials:
#    - VITE_SUPABASE_URL: Found in Supabase Dashboard -> Settings -> API -> URL
#    - VITE_SUPABASE_ANON_KEY: Found in Supabase Dashboard -> Settings -> API -> anon public key
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
