# ==============================================================================
# Edsy Notes - Supabase Environment Configuration
# ==============================================================================
# Copy this file to `.env` or `.env.local` inside the `web/` directory and fill
# in your project credentials from your Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys (anon / public)
# ==============================================================================

# Your Supabase Project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anon Public Key (starts with eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
